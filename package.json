{
  "name": "nax",
  "productName": "NaX",
  "version": "0.1.0",
  "description": "NaX — navigateur open source (Chromium via Electron) pensé pour l'organisation",
  "author": "NaX",
  "license": "MIT",
  "homepage": "https://github.com/OWNER/nax",
  "repository": {
    "type": "git",
    "url": "https://github.com/OWNER/nax.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "publish": "electron-builder --publish always"
  },
  "build": {
    "appId": "com.nax.browser",
    "productName": "NaX",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "peek-preload.js",
      "fly-preload.js",
      "menu-preload.js",
      "tip-preload.js",
      "find-preload.js",
      "suggest-preload.js",
      "content-preload.js",
      "ui/**/*",
      "assets/icon.ico",
      "assets/icon.png"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "OWNER",
        "repo": "nax"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NaX",
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "marked": "^18.0.14",
    "png-to-ico": "^3.0.2",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
